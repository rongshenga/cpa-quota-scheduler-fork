-func (w *RateLimitAutoDisableWorker) recoverCooldown(ctx context.Context, baseURL string, managementKey string, item store.QuotaCooldown, now time.Time) {
+// 只接收具名账号的新鲜恢复证据；写入仍沿原身份核对、互斥及回滚事务。
+func (w *RateLimitAutoDisableWorker) RecoverVerifiedCooldown(ctx context.Context, request model.VerifiedQuotaRecovery) (bool, error) {
+	w.operationMu.Lock()
+	defer w.operationMu.Unlock()
+	if w.store == nil || w.store.QuotaCooldowns == nil {
+		return false, errors.New("recovery_store_unavailable")
+	}
+	base, key := w.runtimeConfig()
+	if base == "" || key == "" {
+		return false, errors.New("recovery_upstream_unavailable")
+	}
+	active, err := w.store.QuotaCooldowns.ListActive(ctx)
+	if err != nil {
+		return false, err
+	}
+	var target *store.QuotaCooldown
+	for i := range active {
+		item := &active[i]
+		if item.AuthFileName == request.AuthFileName && item.AuthIndex == request.AuthIndex && item.Provider == request.Provider {
+			if target != nil {
+				return false, errors.New("recovery_identity_ambiguous")
+			}
+			target = item
+		}
+	}
+	if target == nil {
+		return false, nil
+	}
+	if !request.Confirms(*target, time.Now()) {
+		return false, errors.New("recovery_evidence_invalid")
+	}
+	w.recoverCooldown(ctx, base, key, *target, time.Now(), &request)
+	active, err = w.store.QuotaCooldowns.ListActive(ctx)
+	if err != nil {
+		return false, err
+	}
+	for _, item := range active {
+		if item.ID == target.ID {
+			return false, errors.New("recovery_pending")
+		}
+	}
+	current, ok, err := w.currentAuthFileTarget(ctx, base, key, cpaauthfiles.Identity{AuthFileName: target.AuthFileName, AuthIndex: target.AuthIndex, Provider: target.Provider, AccountSnapshot: target.AccountSnapshot})
+	if err != nil || !ok || current.File.Disabled {
+		return false, errors.New("recovery_not_enabled")
+	}
+	log.Printf("[quota-auto-disable] verified early recovery completed id=%d", target.ID)
+	return true, nil
+}
