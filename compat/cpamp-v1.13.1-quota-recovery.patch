+func (h *Handler) RecoverVerified(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodPost {
+		response.MethodNotAllowed(w)
+		return
+	}
+	// 此服务间入口拒绝浏览器来源，保留既有管理认证，不允许参数携带密钥。
+	if r.Header.Get("Origin") != "" || r.URL.RawQuery != "" {
+		http.Error(w, "recovery_request_invalid", http.StatusBadRequest)
+		return
+	}
+	if !middleware.AuthorizePanel(w, r, h.App.AdminAuthService) {
+		return
+	}
+	if h.App.QuotaRecoveryService == nil {
+		http.Error(w, "recovery_unavailable", http.StatusServiceUnavailable)
+		return
+	}
+	var request model.VerifiedQuotaRecovery
+	decoder := json.NewDecoder(http.MaxBytesReader(w, r.Body, 8192))
+	decoder.DisallowUnknownFields()
+	if decoder.Decode(&request) != nil || decoder.Decode(new(any)) != io.EOF {
+		http.Error(w, "recovery_request_invalid", http.StatusBadRequest)
+		return
+	}
+	recovered, err := h.App.QuotaRecoveryService.RecoverVerifiedCooldown(r.Context(), request)
+	if err != nil {
+		http.Error(w, "recovery_not_confirmed", http.StatusConflict)
+		return
+	}
+	response.JSON(w, http.StatusOK, map[string]bool{"recovered": recovered})
+}
