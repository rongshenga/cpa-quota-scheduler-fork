index 0000000..b103f18
--- /dev/null
+++ b/apps/manager-server/internal/model/quota_recovery.go
@@ -0,0 +1,92 @@
+package model
+
+import (
+	"math"
+	"time"
+)
+
+type QuotaRecoveryWindow struct {
+	UsedPercent   *float64 `json:"usedPercent"`
+	WindowSeconds int64    `json:"windowSeconds"`
+	ResetAtMS     int64    `json:"resetAtMs"`
+}
+
+// 同一冷却修订与新鲜窗口共同限定提前恢复，防止旧证据解除后续新禁用。
+type VerifiedQuotaRecovery struct {
+	AuthFileName         string                `json:"authFileName"`
+	AuthIndex            string                `json:"authIndex"`
+	Provider             string                `json:"provider"`
+	ExpectedDisabledAtMS int64                 `json:"expectedDisabledAtMs"`
+	ExpectedRecoverAtMS  int64                 `json:"expectedRecoverAtMs"`
+	ExpectedUpdatedAtMS  int64                 `json:"expectedUpdatedAtMs"`
+	ObservedAtMS         int64                 `json:"observedAtMs"`
+	StartedAtMS          int64                 `json:"startedAtMs"`
+	Source               string                `json:"source"`
+	Windows              []QuotaRecoveryWindow `json:"windows"`
+}
+
+func (r VerifiedQuotaRecovery) Confirms(item QuotaCooldown, now time.Time) bool {
+	if r.AuthFileName == "" || r.AuthIndex == "" || r.Provider != "codex" || r.AuthFileName != item.AuthFileName || r.AuthIndex != item.AuthIndex || item.Provider != "codex" || item.Owner != QuotaCooldownOwnerUsage429 || item.PreDisabledState || item.Status != QuotaCooldownStatusActive || item.ReasonCode != "codex_usage_limit_reached" {
+		return false
+	}
+	if r.ExpectedRecoverAtMS <= 0 || r.ExpectedDisabledAtMS <= 0 || r.ExpectedUpdatedAtMS <= 0 || r.ExpectedDisabledAtMS != item.DisabledAtMS || r.ExpectedRecoverAtMS != item.RecoverAtMS || r.ExpectedUpdatedAtMS != item.UpdatedAtMS {
+		return false
+	}
+	if r.StartedAtMS <= item.DisabledAtMS || r.ObservedAtMS < r.StartedAtMS || r.ObservedAtMS > now.UnixMilli()+5000 || now.UnixMilli()-r.ObservedAtMS > 120000 || r.Source != "probe" && r.Source != "response" {
+		return false
+	}
+	if len(r.Windows) < 1 || len(r.Windows) > 2 {
+		return false
+	}
+	long, primary, changed := false, false, false
+	allChanged := true
+	for _, w := range r.Windows {
+		if w.UsedPercent == nil || math.IsNaN(*w.UsedPercent) || math.IsInf(*w.UsedPercent, 0) || *w.UsedPercent < 0 || *w.UsedPercent >= 100 || w.ResetAtMS <= now.UnixMilli() {
+			return false
+		}
+		kind := ""
+		switch {
+		case w.WindowSeconds >= 299*60 && w.WindowSeconds <= 301*60:
+			if primary {
+				return false
+			}
+			primary = true
+			kind = "five_hour"
+		case w.WindowSeconds >= 10079*60 && w.WindowSeconds <= 10081*60:
+			if long {
+				return false
+			}
+			long = true
+			kind = "weekly"
+		case w.WindowSeconds >= 40319*60 && w.WindowSeconds <= 44641*60:
+			if long {
+				return false
+			}
+			long = true
+			kind = "monthly"
+		default:
+			return false
+		}
+		if w.ResetAtMS > now.UnixMilli()+w.WindowSeconds*1000+180000 {
+			return false
+		}
+		if absMillis(w.ResetAtMS-item.RecoverAtMS) <= 60000 {
+			allChanged = false
+		}
+		if kind == item.WindowKind && absMillis(w.ResetAtMS-item.RecoverAtMS) > 60000 {
+			changed = true
+		}
+	}
+	// 正常成功响应可证明同周期已可用；纯额度读取必须有被耗尽窗口的身份变化。
+	if item.WindowKind == "unknown" {
+		return long && primary && (r.Source == "response" || allChanged)
+	}
+	return long && (item.WindowKind != "five_hour" || primary) && (item.WindowKind == "five_hour" || item.WindowKind == "weekly" || item.WindowKind == "monthly") && (r.Source == "response" || changed)
+}
+
+func absMillis(value int64) int64 {
+	if value < 0 {
+		return -value
+	}
+	return value
+}
